[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[user]
	name = Utah Ingersoll
	email = hatutah@gmail.com
[init]
	defaultBranch = main
[include]
	# per-machine settings (signing key, work email, ...) - not tracked
	path = ~/.gitconfig.local
