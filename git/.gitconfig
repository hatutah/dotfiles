# Shared git config. Identity is per machine: set it in ~/.gitconfig.local
# (not tracked), which is included at the bottom of this file, e.g.
#
#   [user]
#   	name = Your Name
#   	email = you@example.com
#   	signingkey = ssh-ed25519 AAAA...   # public key, 1Password signs with it
#
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[include]
	path = ~/.gitconfig.local
